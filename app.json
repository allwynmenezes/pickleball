{
  "expo": {
    "name": "The Pickle Slot",
    "slug": "the-pickle-slot",
    "scheme": "thepickleslot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6200EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thepickleslot.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6200EA"
      },
      "package": "com.thepickleslot.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
