{
  "expo": {
    "name": "Courtside",
    "slug": "courtside",
    "scheme": "courtside",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6200EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.courtside.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6200EA"
      },
      "package": "com.courtside.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}
