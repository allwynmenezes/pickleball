{
  "name": "the-pickle-slot-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute pickle-slot --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute pickle-slot --remote --file=schema.sql",
    "test": "node test/api.test.mjs",
    "db:fresh:local": "node -e \"require('fs').rmSync('.wrangler/state', { recursive: true, force: true })\" && npm run db:init:local"
  },
  "devDependencies": {
    "wrangler": "^4.140.0"
  }
}
