# Copy this file to .env (already gitignored) and fill in real values.

# Deployed Google Apps Script web app URL that sends OTP emails.
# See backend/email/apps-script.gs for the script + deployment steps.
APPS_SCRIPT_URL=
# Shared secret the Apps Script checks before sending — must match the
# SHARED_SECRET script property set in that project.
APPS_SCRIPT_SECRET=

# Without the two vars above set, OTPs are logged to the server console
# instead of emailed, so the login flow is still testable locally.
