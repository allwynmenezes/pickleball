# Claude Code local tool state (worktrees, etc.) — not project source
.claude/

# Dependencies (run npm install; see package-lock.json)
node_modules/

# Expo local state and caches (regenerated by `expo start`)
.expo/
.expo-shared/

# Build output: web exports, generated native projects, app bundles
dist/
web-build/
/android
/ios
*.apk
*.aab
*.ipa

# Signing keys — never commit these
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Backend runtime data (local SQLite database and its journal files)
backend/data.sqlite
backend/data.sqlite-*

# Env files and local secrets
.env
.env.local
.env.*.local
.dev.vars

# Logs and OS clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
